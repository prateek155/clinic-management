# Neon PostgreSQL (use the JDBC URL from Neon Connect; keep SSL enabled)
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
DB_USERNAME=YOUR_NEON_ROLE
DB_PASSWORD=YOUR_NEON_PASSWORD

# Firebase Admin SDK (keep the service-account JSON outside this repository)
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-admin.json

# Local app settings
SERVER_PORT=8080
OPENAPI_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: first clinic/doctor setup. Leave disabled for patient-only setup.
BOOTSTRAP_CLINIC_ENABLED=false
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_CLINIC_NAME=Careflow Clinic

# Optional: only used if you choose local PostgreSQL with Docker Compose.
# POSTGRES_PASSWORD=choose-a-local-password
